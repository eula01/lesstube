{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?endpoint=:path*"
    },
    {
      "source": "/((?!download/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "data/{index.json.gz,export.json,embeddings.json.gz}"
    }
  }
}
